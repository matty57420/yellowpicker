# Modèle de /etc/yellowpicker.env (chmod 600, root:yellowpicker).
# Ce fichier-ci est un modèle committé : il ne doit JAMAIS contenir de secret.

NODE_ENV=production

# Caddy est le seul point d'entrée : le serveur Node n'écoute que sur la boucle
# locale, donc impossible de contourner le TLS en tapant http://<ip>:3000.
HOST=127.0.0.1
PORT=3000

# Le serveur est derrière Caddy : sans ça, le rate-limit du login voit toutes les
# requêtes comme venant de 127.0.0.1 et son quota devient global au lieu d'être
# par IP. À ne jamais mettre à true si le serveur est exposé en direct.
TRUST_PROXY=true

# Chemins absolus : loadConfig fait un path.resolve(), donc en relatif la
# résolution dépendrait du WorkingDirectory de l'unité systemd.
DATA_DIR=/srv/yellowpicker/server/data
CLIENT_DIST=/srv/yellowpicker/client/dist

# Compte admin créé OU mis à jour à chaque démarrage (cf. seedAdmin).
# Changer le mot de passe ici puis redémarrer = changer le mot de passe admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
