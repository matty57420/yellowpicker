# Copier en server/.env (jamais commité)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=data
# Build Vite servi en production (relatif au cwd du serveur, ou chemin absolu)
CLIENT_DIST=../client/dist
# Mettre à true UNIQUEMENT derrière un reverse proxy de confiance (cf. docs/deployment.md) :
# sinon n'importe quel client peut usurper son IP via X-Forwarded-For.
TRUST_PROXY=false
# Compte admin créé/mis à jour au démarrage (mot de passe ≥ 10 caractères)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
